<!--
  What Lin's accessibility service asks for, and nothing beyond it.

  flagReportViewIds is the one that is not optional: without it every node arrives with no
  viewIdResourceName, which is what the per-app composer recipes are matched on, and the whole
  feature falls back to guessing from labels alone.

  No flagRequestFilterKeyEvents, no flagRequestTouchExplorationMode, no
  flagRequestFingerprintGestures, no flagRequestShortcutWarningDialogSpokenFeedback: Lin reads
  the tree when asked and performs two actions on it. It does not need the key events or the
  touch stream, so it does not ask for them.

  notificationTimeout is high rather than zero. Events are not used at all - see
  onAccessibilityEvent - so there is no reason to be woken often, and a service that asks to be
  called on every content change in every app is a service costing battery for nothing.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="500"
    android:description="@string/accessibility_description"
    android:summary="@string/accessibility_summary" />
