<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 form of data_extraction_rules.xml, kept in step with it.

  Lin: minSdk is 31, so in practice the other file is the one that applies. This
  exists because the manifest names it and because a divergence between the two is the kind of
  thing that is only noticed on the one device where it matters.
-->
<full-backup-content>
    <exclude domain="file" path="datastore" />
    <exclude domain="file" path="skills" />
    <exclude domain="external" path="imports" />
</full-backup-content>
