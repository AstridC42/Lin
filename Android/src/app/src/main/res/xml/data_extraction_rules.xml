<?xml version="1.0" encoding="utf-8"?>
<!--
  What leaves the device in a backup or a device-to-device transfer.

  Lin: the app's settings hold credentials the user typed in - a Home Assistant
  long-lived access token, an Authorization header for a SearXNG instance behind a proxy - and
  everything the assistant has been told to remember about them. None of that needs to be in a
  cloud backup to make a restored phone usable: the app works without it and asks again.

  The upstream default backed all of it up, because this file was the template's commented-out
  sample. Android 12+ cloud backups are encrypted with a key tied to the device lock, so this was
  not an exposure so much as a larger blast radius than the feature needs.

  Chat history and downloaded models are excluded for a different reason: a model is gigabytes and
  a conversation is nobody's business but the owner's.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="skills" />
        <exclude domain="external" path="imports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="external" path="imports" />
    </device-transfer>
</data-extraction-rules>
