<?xml version="1.0" encoding="utf-8"?>
<!--
  The card the assistant appears in when it is summoned over another app. Opaque rather than
  translucent: whatever is behind it is somebody else's screen, and text read at a glance while
  driving or walking cannot compete with a photo showing through.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="?android:attr/colorBackground" />
    <stroke android:width="1dp" android:color="#33888888" />
</shape>
